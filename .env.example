# GEMINI_API_KEY: Required for Gemini AI matching and roadmap generation on server / Edge Functions.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL of the deployed application.
APP_URL="http://localhost:3000"

# SESSION_SECRET: Secret for signing auth session cookies in Express fallback server.
SESSION_SECRET="skillswap-dev-secret-change-in-production"

# Optional Supabase Configuration (leave unset in AI Studio preview to use built-in SQLite + Express backend)
# VITE_SUPABASE_URL="https://your-project.supabase.co"
# VITE_SUPABASE_ANON_KEY="your-anon-key"
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
